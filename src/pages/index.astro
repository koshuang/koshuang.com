---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0,5);
---
<Layout>
  <section class="hero">
    <div class="eyebrow">CTO · Builder · AI-native operator</div>
    <h1>Build. Learn. Share.</h1>
    <p>我是 Kos Huang。這裡是我的公開工作台：記錄 AI、軟體工程、技術領導、產品，以及把想法真正做成結果的過程。</p>
  </section>
  <section class="section">
    <h2>Latest writing</h2>
    <ul class="list">
      {posts.map(post => <li><a href={`/blog/${post.id}/`}>{post.data.title}</a><span class="meta">{post.data.pubDate.toLocaleDateString('zh-TW')}</span></li>)}
    </ul>
  </section>
</Layout>
